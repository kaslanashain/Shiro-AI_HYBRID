# Shiro AI — Environment Variables
# Copy to .env and fill in values

# REQUIRED for production
SECRET_KEY=change-this-to-random-string-in-production
GROQ_API_KEY=

# Optional AI — Vision (image analysis)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_MODEL_SHIRO=shiro-ai
OLLAMA_MODEL_SISHIN=sishin-ai
OLLAMA_HOST=http://127.0.0.1:11434
# Path GGUF lokal — otomatis dipakai jika file lengkap (lihat scripts/gguf_local.py)
# OLLAMA_GGUF_PATH=F:/Shiro_AI_V2/qwen2.5-7b-instruct-q4_k_m-00001-of-00002.gguf
# Paksa registry saja (tanpa GGUF): OLLAMA_USE_LOCAL_GGUF=false

# Opsi generasi offline (lebih pintar dari default lama)
OLLAMA_OFFLINE_TEMP=0.78
OLLAMA_OFFLINE_NUM_PREDICT=160
OLLAMA_NUM_CTX=4096
OLLAMA_KEEP_ALIVE=30m
# Satu model untuk Shiro+Sishin offline (lebih cepat, hindari swap RAM)
OLLAMA_OFFLINE_SHARED=true
GROQ_MODEL=llama-3.3-70b-versatile

# Voice
VOICEVOX_URL=http://localhost:50021

# Server
FLASK_DEBUG=false
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
CORS_ORIGINS=*

# Production cookies (set true behind HTTPS)
SESSION_COOKIE_SECURE=false

# Limits
MAX_CACHE=100
MAX_TTS_FILES=50
MAX_UPLOAD_BYTES=5242880
MAX_VIDEO_UPLOAD_BYTES=20971520
VIDEO_KEYFRAME_COUNT=4
